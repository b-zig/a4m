{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a4m.local/schema/a4m.schema.json",
  "title": "a4m model file",
  "description": "One YAML file of an a4m solution architecture (models/<sa>/**/*.yaml).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "model.yaml only: model name."
    },
    "version": {
      "type": [
        "string",
        "number"
      ],
      "description": "model.yaml only."
    },
    "documentation": {
      "type": "string",
      "description": "model.yaml only."
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "Free-form key/value properties (exported to Archi)."
    },
    "kind": {
      "enum": [
        "solution",
        "platform",
        "enterprise"
      ],
      "default": "solution",
      "description": "model.yaml only: solution, platform (consumed by other SAs) or enterprise."
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "implemented",
        "rejected"
      ],
      "default": "draft",
      "description": "model.yaml only: lifecycle of the SA; changes reach the landscape target once approved."
    },
    "owner": {
      "type": "string",
      "description": "model.yaml only: owning team or person."
    },
    "exports": {
      "oneOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      ],
      "description": "model.yaml only: ids other SAs may reference as <sa>/<id> (\"*\" = all)."
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Stable kebab-case id; prefix by layer, e.g. app-nextcloud."
        },
        "type": {
          "enum": [
            "ApplicationCollaboration",
            "ApplicationComponent",
            "ApplicationEvent",
            "ApplicationFunction",
            "ApplicationInteraction",
            "ApplicationInterface",
            "ApplicationProcess",
            "ApplicationService",
            "Artifact",
            "Assessment",
            "BusinessActor",
            "BusinessCollaboration",
            "BusinessEvent",
            "BusinessFunction",
            "BusinessInteraction",
            "BusinessInterface",
            "BusinessObject",
            "BusinessProcess",
            "BusinessRole",
            "BusinessService",
            "Capability",
            "CommunicationNetwork",
            "Constraint",
            "Contract",
            "CourseOfAction",
            "DataObject",
            "Deliverable",
            "Device",
            "DistributionNetwork",
            "Driver",
            "Equipment",
            "Facility",
            "Gap",
            "Goal",
            "Grouping",
            "ImplementationEvent",
            "Junction",
            "Location",
            "Material",
            "Meaning",
            "Node",
            "Outcome",
            "Path",
            "Plateau",
            "Principle",
            "Product",
            "Representation",
            "Requirement",
            "Resource",
            "Stakeholder",
            "SystemSoftware",
            "TechnologyCollaboration",
            "TechnologyEvent",
            "TechnologyFunction",
            "TechnologyInteraction",
            "TechnologyInterface",
            "TechnologyProcess",
            "TechnologyService",
            "Value",
            "ValueStream",
            "WorkPackage"
          ],
          "description": "ArchiMate 3.2 element type."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Free-form key/value properties (exported to Archi)."
        },
        "c4": {
          "enum": [
            "component",
            "container",
            "deployment",
            "person",
            "system"
          ],
          "description": "Opt this element into C4 views."
        },
        "c4_shape": {
          "enum": [
            "database",
            "queue"
          ]
        },
        "external": {
          "type": "boolean",
          "description": "C4: render as *_Ext (outside the enterprise boundary)."
        },
        "junction_type": {
          "enum": [
            "and",
            "or"
          ],
          "description": "Only for type Junction."
        },
        "state": {
          "enum": [
            "existing",
            "new",
            "changed",
            "retiring"
          ],
          "default": "existing",
          "description": "Change state: existing (default), new, changed or retiring."
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "type",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Optional; defaults to rel-<source>-<type>-<target>."
        },
        "type": {
          "enum": [
            "Composition",
            "Aggregation",
            "Assignment",
            "Realization",
            "Serving",
            "Access",
            "Influence",
            "Triggering",
            "Flow",
            "Specialization",
            "Association"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*/)?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Element id, or <sa>/<id> for an element exported by another SA."
        },
        "target": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*/)?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Element id, or <sa>/<id> for an element exported by another SA."
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Free-form key/value properties (exported to Archi)."
        },
        "access": {
          "enum": [
            "access",
            "read",
            "write",
            "readwrite"
          ],
          "description": "Only for Access (default write, as in ArchiMate)."
        },
        "modifier": {
          "type": "string",
          "description": "Only for Influence, e.g. '+', '++', '-'."
        },
        "directed": {
          "type": "boolean",
          "description": "Only for Association."
        },
        "state": {
          "enum": [
            "existing",
            "new",
            "changed",
            "retiring"
          ],
          "default": "existing",
          "description": "Change state: existing (default), new, changed or retiring."
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "archimate",
            "c4-context",
            "c4-container",
            "c4-component",
            "c4-deployment"
          ],
          "default": "archimate"
        },
        "documentation": {
          "type": "string"
        },
        "viewpoint": {
          "enum": [
            "Organization",
            "Information Structure",
            "Technology",
            "Layered",
            "Physical",
            "Product",
            "Application Structure",
            "Application Usage",
            "Technology Usage",
            "Business Process Cooperation",
            "Application Cooperation",
            "Service Realization",
            "Implementation and Deployment",
            "Goal Realization",
            "Requirements Realization",
            "Motivation",
            "Strategy",
            "Capability Map",
            "Outcome Realization",
            "Resource Map",
            "Project",
            "Migration",
            "Implementation and Migration",
            "Stakeholder",
            "Value Stream"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*/)?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Element id, or <sa>/<id> for an element exported by another SA."
          },
          "uniqueItems": true
        },
        "include_layers": {
          "type": "array",
          "items": {
            "enum": [
              "motivation",
              "strategy",
              "business",
              "application",
              "technology",
              "physical",
              "implementation",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*/)?[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "C4 views: the system/container/deployment node in focus."
        },
        "state": {
          "enum": [
            "change",
            "baseline",
            "target"
          ],
          "default": "change",
          "description": "change (default: everything, changes highlighted), baseline or target."
        },
        "layout": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "description": "Optional fixed [x, y, w, h] per element id (captured by import-oef); otherwise auto-layout."
        }
      }
    }
  }
}
